	column categoria_exibicao =
			
			VAR CategoriaOriginal =
			    dim_produtos[product_category_name]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CategoriaOriginal), "Sem categoria",
			        CategoriaOriginal = "beleza_saude", "Beleza e Saúde",
			        CategoriaOriginal = "relogios_presentes", "Relógios e Presentes",
			        CategoriaOriginal = "cama_mesa_banho", "Cama, Mesa e Banho",
			        CategoriaOriginal = "esporte_lazer", "Esporte e Lazer",
			        CategoriaOriginal = "informatica_acessorios", "Informática e Acessórios",
			        CategoriaOriginal = "moveis_decoracao", "Móveis e Decoração",
			        CategoriaOriginal = "cool_stuff", "Cool Stuff",
			        CategoriaOriginal = "utilidades_domesticas", "Utilidades Domésticas",
			        CategoriaOriginal = "automotivo", "Automotivo",
			        CategoriaOriginal = "ferramentas_jardim", "Ferramentas e Jardim",
			        CategoriaOriginal = "brinquedos", "Brinquedos",
			        CategoriaOriginal = "telefonia", "Telefonia",
			        CategoriaOriginal = "perfumaria", "Perfumaria",
			        CategoriaOriginal = "bebes", "Bebês",
			        CategoriaOriginal = "eletronicos", "Eletrônicos",
			        CategoriaOriginal = "fashion_bolsas_e_acessorios", "Moda, Bolsas e Acessórios",
			        CategoriaOriginal = "pet_shop", "Pet Shop",
			        CategoriaOriginal = "moveis_escritorio", "Móveis de Escritório",
			        CategoriaOriginal = "eletrodomesticos", "Eletrodomésticos",
			        CategoriaOriginal = "construcao_ferramentas_construcao", "Construção e Ferramentas",
			        CategoriaOriginal = "papelaria", "Papelaria",
			        CategoriaOriginal = "malas_acessorios", "Malas e Acessórios",
			        CategoriaOriginal = "consoles_games", "Consoles e Games",
			        CategoriaOriginal = "alimentos_bebidas", "Alimentos e Bebidas",
			        CategoriaOriginal = "livros_interesse_geral", "Livros de Interesse Geral",
			        CategoriaOriginal = "artes", "Artes",
			        CategoriaOriginal = "casa_construcao", "Casa e Construção",
			        SUBSTITUTE(CategoriaOriginal, "_", " ")
			    )
		lineageTag: 402b7ef9-8d90-48e9-9847-6ee282ac3d70
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_produtos = m
		mode: import
