				let
				    Fonte = PostgreSQL.Database("localhost:5432", "inteligencia_receita_db"),
				    gold_dim_produtos = Fonte{[Schema="gold",Item="dim_produtos"]}[Data],
				    #"Outras Colunas Removidas" = Table.SelectColumns(gold_dim_produtos,{"produto_sk", "product_id", "product_category_name", "product_category_name_english", "membro_tipo"})
				in
				    #"Outras Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

