	column vendedor_exibicao =
			
			SWITCH(
			    dim_vendedores[membro_tipo],
			    "regular",
			        "Vendedor " &
			        FORMAT(dim_vendedores[vendedor_sk], "0"),
			    "nao_informado", "Vendedor não informado",
			    "referencia_nao_encontrada", "Vendedor não encontrado",
			    "Vendedor sem classificação"
			)
