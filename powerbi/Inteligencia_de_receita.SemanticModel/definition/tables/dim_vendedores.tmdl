				    gold_dim_vendedores = Fonte{[Schema="gold",Item="dim_vendedores"]}[Data],
				    #"Outras Colunas Removidas" = Table.SelectColumns(gold_dim_vendedores,{"vendedor_sk", "seller_id", "seller_zip_code_prefix", "seller_city", "seller_state", "membro_tipo"})
