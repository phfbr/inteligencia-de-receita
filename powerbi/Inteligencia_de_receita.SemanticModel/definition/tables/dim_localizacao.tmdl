	column 'UF Cliente Mapa' = ```
			
			VAR UF = dim_localizacao[customer_state]
			RETURN
			    IF (
			        LEN ( UF ) = 2,
			        UF & ", Brasil",
			        BLANK ()
			    )
			
			```
		lineageTag: f78d18da-f4ff-4e5d-98a6-c25ea781ef23
		dataCategory: Place
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Estado Cliente Mapa' = ```
			
			SWITCH (
			    dim_localizacao[customer_state],
			    "AC", "Acre",
			    "AL", "Alagoas",
			    "AP", "Amapá",
			    "AM", "Amazonas",
			    "BA", "Bahia",
			    "CE", "Ceará",
			    "DF", "Distrito Federal",
			    "ES", "Espírito Santo",
			    "GO", "Goiás",
			    "MA", "Maranhão",
			    "MT", "Mato Grosso",
			    "MS", "Mato Grosso do Sul",
			    "MG", "Minas Gerais",
			    "PA", "Pará",
			    "PB", "Paraíba",
			    "PR", "Paraná",
			    "PE", "Pernambuco",
			    "PI", "Piauí",
			    "RJ", "Rio de Janeiro",
			    "RN", "Rio Grande do Norte",
			    "RS", "Rio Grande do Sul",
			    "RO", "Rondônia",
			    "RR", "Roraima",
			    "SC", "Santa Catarina",
			    "SP", "São Paulo",
			    "SE", "Sergipe",
			    "TO", "Tocantins",
			    BLANK ()
			)
			
			```
		lineageTag: bfbbff2d-2843-44ec-b83a-f8576418c8a4
		dataCategory: StateOrProvince
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'País Cliente' = ```
			"Brasil"
			
			```
		lineageTag: 934d7f06-155d-4e41-9760-5312a0d31915
		dataCategory: Country
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Localizacao Brasil' =
			
			VAR Estado = dim_localizacao[Estado Cliente Mapa]
			RETURN
			    IF (
			        NOT ISBLANK ( Estado ),
			        Estado & ", Brasil",
			        BLANK ()
			    )
		lineageTag: 25f73a9a-9843-4916-8292-5527afe17199
		dataCategory: Place
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

