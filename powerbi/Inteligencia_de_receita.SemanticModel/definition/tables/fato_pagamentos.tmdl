	column 'Tipo Pagamento PT' = ```
			
			SWITCH (
			    fato_pagamentos[payment_type],
			    "credit_card", "Cartão de crédito",
			    "boleto", "Boleto",
			    "voucher", "Voucher",
			    "debit_card", "Cartão de débito",
			    "not_defined", "Não definido",
			    fato_pagamentos[payment_type]
			)
			
			```
		lineageTag: c191ef56-4379-48d8-aa30-96bfe9b33af6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa de Parcelamento' = ```
			
			VAR Parcelas = fato_pagamentos[payment_installments]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Parcelas ), "Não informado",
			        Parcelas = 0, "0 parcelas",
			        Parcelas = 1, "1 parcela",
			        Parcelas <= 3, "2–3 parcelas",
			        Parcelas <= 6, "4–6 parcelas",
			        Parcelas <= 10, "7–10 parcelas",
			        "11+ parcelas"
			    )
			
			```
		lineageTag: e24827b0-2b5f-45ea-82b3-98630d4eeb18
		summarizeBy: none
		sortByColumn: 'Ordem Faixa Parcelamento'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Ordem Faixa Parcelamento' = ```
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( fato_pagamentos[payment_installments] ), 7,
			    fato_pagamentos[payment_installments] = 0, 1,
			    fato_pagamentos[payment_installments] = 1, 2,
			    fato_pagamentos[payment_installments] <= 3, 3,
			    fato_pagamentos[payment_installments] <= 6, 4,
			    fato_pagamentos[payment_installments] <= 10, 5,
			    6
			)
			
			```
		formatString: 0
		lineageTag: abe63355-3fa9-459d-b4a7-a3c095b48f75
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

