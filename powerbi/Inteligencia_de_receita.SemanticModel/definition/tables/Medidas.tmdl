	measure 'Concentração Top 10 Vendedores' =
			
			VAR TopVendedores =
			    TOPN(
			        10,
			        ALL(dim_vendedores[vendedor_sk]),
			        [Valor dos Produtos], DESC,
			        dim_vendedores[vendedor_sk], ASC
			    )
			VAR ValorTop10 =
			    CALCULATE(
			        [Valor dos Produtos],
			        KEEPFILTERS(TopVendedores)
			    )
			VAR ValorTotal =
			    CALCULATE(
			        [Valor dos Produtos],
			        REMOVEFILTERS(dim_vendedores[vendedor_sk])
			    )
			RETURN
			    DIVIDE(
			        ValorTop10,
			        ValorTotal
			    )
		displayFolder: 02 - Desempenho Comercial
		lineageTag: 3c33d32f-858d-4b15-bc94-fb2fc2ff1f5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor dos Produtos por Faixa' = ```
			
			VAR Base =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_vendedores[vendedor_sk] ),
			            "@Itens",
			                CALCULATE (
			                    COUNTROWS ( fato_itens_pedido )
			                ),
			            "@Valor",
			                CALCULATE ( [Valor dos Produtos] )
			        ),
			        [@Itens] > 0
			    )
			
			VAR Top10 =
			    TOPN (
			        10,
			        Base,
			        IF ( ISBLANK ( [@Valor] ), 0, 1 ), DESC,
			        [@Valor], DESC,
			        dim_vendedores[vendedor_sk], ASC
			    )
			
			VAR Top50 =
			    TOPN (
			        50,
			        Base,
			        IF ( ISBLANK ( [@Valor] ), 0, 1 ), DESC,
			        [@Valor], DESC,
			        dim_vendedores[vendedor_sk], ASC
			    )
			
			VAR Top100 =
			    TOPN (
			        100,
			        Base,
			        IF ( ISBLANK ( [@Valor] ), 0, 1 ), DESC,
			        [@Valor], DESC,
			        dim_vendedores[vendedor_sk], ASC
			    )
			
			VAR ChavesBase =
			    SELECTCOLUMNS (
			        Base,
			        "@SK", dim_vendedores[vendedor_sk]
			    )
			
			VAR Chaves10 =
			    SELECTCOLUMNS (
			        Top10,
			        "@SK", dim_vendedores[vendedor_sk]
			    )
			
			VAR Chaves50 =
			    SELECTCOLUMNS (
			        Top50,
			        "@SK", dim_vendedores[vendedor_sk]
			    )
			
			VAR Chaves100 =
			    SELECTCOLUMNS (
			        Top100,
			        "@SK", dim_vendedores[vendedor_sk]
			    )
			
			VAR Classificacao =
			    UNION (
			        ADDCOLUMNS ( Chaves10, "@Faixa", 1 ),
			        ADDCOLUMNS (
			            EXCEPT ( Chaves50, Chaves10 ),
			            "@Faixa", 2
			        ),
			        ADDCOLUMNS (
			            EXCEPT ( Chaves100, Chaves50 ),
			            "@Faixa", 3
			        ),
			        ADDCOLUMNS (
			            EXCEPT ( ChavesBase, Chaves100 ),
			            "@Faixa", 4
			        )
			    )
			
			VAR OrdensSelecionadas =
			    VALUES ( 'Faixas Concentração'[Ordem] )
			
			VAR ChavesDasFaixas =
			    SELECTCOLUMNS (
			        FILTER (
			            Classificacao,
			            [@Faixa] IN OrdensSelecionadas
			        ),
			        "@SK", [@SK]
			    )
			
			RETURN
			    IF (
			        ISEMPTY ( Base ),
			        BLANK (),
			        IF (
			            ISEMPTY ( ChavesDasFaixas ),
			            0,
			            CALCULATE (
			                [Valor dos Produtos],
			                KEEPFILTERS (
			                    TREATAS (
			                        ChavesDasFaixas,
			                        dim_vendedores[vendedor_sk]
			                    )
			                )
			            )
			        )
			    )
			
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 02 - Desempenho Comercial
		lineageTag: c3703e8f-8c7a-4225-8bf7-89a1b9ff877a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

