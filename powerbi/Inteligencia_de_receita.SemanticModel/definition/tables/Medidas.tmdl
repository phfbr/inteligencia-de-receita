	measure 'Clientes Elegíveis Contextuais' = ```
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( fato_pedidos[cliente_sk] ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        )
			    ),
			    0
			)
			
			```
		formatString: #,0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: 813f0e68-303d-45f8-870e-3b47bffa6849

	measure 'Clientes com Recompra Contextual' = ```
			
			VAR ClienteDias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            fato_pedidos,
			            dim_clientes[cliente_sk],
			            dim_calendario[dia]
			        ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        ),
			        KEEPFILTERS (
			            NOT ISBLANK ( dim_calendario[dia] )
			        )
			    )
			VAR Perfil =
			    GROUPBY (
			        ClienteDias,
			        dim_clientes[cliente_sk],
			        "@Dias",
			            COUNTX ( CURRENTGROUP (), 1 )
			    )
			RETURN
			    COALESCE (
			        COUNTROWS (
			            FILTER ( Perfil, [@Dias] >= 2 )
			        ),
			        0
			    )
			
			```
		formatString: #,0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: c859c4d1-582c-4e9e-a05b-02e171eeeb83

