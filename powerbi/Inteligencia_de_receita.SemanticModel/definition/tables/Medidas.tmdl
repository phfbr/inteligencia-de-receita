		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Clientes Novos Contextuais' = ```
			
			VAR DataInicial =
			    MIN ( dim_calendario[dia] )
			VAR DataFinal =
			    MAX ( dim_calendario[dia] )
			VAR ClientesAtivos =
			    CALCULATETABLE (
			        VALUES ( fato_pedidos[cliente_sk] ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        )
			    )
			RETURN
			    COALESCE (
			        SUMX (
			            ClientesAtivos,
			            VAR ClienteAtual = fato_pedidos[cliente_sk]
			            VAR PrimeiraCompra =
			                CALCULATE (
			                    MIN ( fato_pedidos[order_purchase_timestamp] ),
			                    REMOVEFILTERS ( dim_calendario ),
			                    REMOVEFILTERS ( dim_localizacao ),
			                    REMOVEFILTERS ( fato_pedidos ),
			                    fato_pedidos[cliente_sk] = ClienteAtual,
			                    fato_pedidos[order_status] = "delivered",
			                    dim_clientes[membro_tipo] = "regular"
			                )
			            RETURN
			                IF (
			                    NOT ISBLANK ( PrimeiraCompra )
			                        && INT ( PrimeiraCompra ) >= DataInicial
			                        && INT ( PrimeiraCompra ) <= DataFinal,
			                    1,
			                    0
			                )
			        ),
			        0
			    )
			
			```
		formatString: #,0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: 5df3d21e-1be4-448e-a50c-9fd6d206ae07

	measure 'Clientes Existentes Contextuais' = ```
			
			VAR ClientesAtivos =
			    [Clientes Elegíveis Contextuais]
			VAR ClientesNovos =
			    [Clientes Novos Contextuais]
			RETURN
			    MAX (
			        0,
			        ClientesAtivos - ClientesNovos
			    )
			
			```
		formatString: 0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: ad839bd6-23f6-48d2-9d98-27f7bd57e71c

	measure 'Clientes por Frequencia' = ```
			
			VAR MinimoPedidos =
			    SELECTEDVALUE ( 'Faixas Frequencia'[Minimo] )
			VAR MaximoPedidos =
			    SELECTEDVALUE ( 'Faixas Frequencia'[Maximo] )
			
			VAR PedidosPorCliente =
			    CALCULATETABLE (
			        SUMMARIZE (
			            fato_pedidos,
			            fato_pedidos[cliente_sk],
			            "@Pedidos",
			                DISTINCTCOUNT ( fato_pedidos[order_id] )
			        ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        )
			    )
			
			RETURN
			    IF (
			        ISBLANK ( MinimoPedidos )
			            || ISBLANK ( MaximoPedidos ),
			        BLANK (),
			        COALESCE (
			            COUNTROWS (
			                FILTER (
			                    PedidosPorCliente,
			                    [@Pedidos] >= MinimoPedidos
			                        && [@Pedidos] <= MaximoPedidos
			                )
			            ),
			            0
			        )
			    )
			
			```
		formatString: #,0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: c1d3d32c-7abb-45c8-82bf-47429ddb352a

	measure 'Clientes por Perfil de Recompra' = ```
			
			VAR PerfilSelecionado =
			    SELECTEDVALUE ( 'Faixas Perfil Recompra'[Ordem] )
			
			VAR ClientesPedidoUnico =
			    CALCULATE (
			        [Clientes por Frequencia],
			        REMOVEFILTERS ( 'Faixas Frequencia' ),
			        'Faixas Frequencia'[Ordem] = 1
			    )
			
			VAR ClientesRecompra =
			    [Clientes com Recompra Contextual]
			
			VAR ClientesMultiplosMesmoDia =
			    [Clientes Elegíveis Contextuais]
			        - ClientesPedidoUnico
			        - ClientesRecompra
			
			RETURN
			    SWITCH (
			        PerfilSelecionado,
			        1, ClientesPedidoUnico,
			        2, ClientesMultiplosMesmoDia,
			        3, ClientesRecompra,
			        BLANK ()
			    )
			
			```
		formatString: #,0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: 2aff3c9c-ee34-42fd-92dd-54573031fa79

	measure 'Dias Distintos de Compra' = ```
			
			VAR PedidosElegiveis =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            fato_pedidos,
			            "@DataCompra",
			                INT ( fato_pedidos[order_purchase_timestamp] )
			        ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        ),
			        KEEPFILTERS (
			            NOT ISBLANK ( fato_pedidos[order_purchase_timestamp] )
			        )
			    )
			RETURN
			    COALESCE (
			        COUNTROWS (
			            DISTINCT ( PedidosElegiveis )
			        ),
			        0
			    )
			
			```
		formatString: 0
		displayFolder: 03 - Clientes e Recompra
		lineageTag: 306c8c83-f9cd-4d5a-b2aa-8404c779760e

	measure 'Classificacao de Recompra Cliente' = ```
			
			VAR Pedidos =
			    [Pedidos Entregues Elegíveis]
			VAR Dias =
			    [Dias Distintos de Compra]
			RETURN
			    SWITCH (
			        TRUE (),
			        Pedidos = 0, BLANK (),
			        Pedidos = 1, "Pedido único",
			        Dias >= 2, "Recompra RN07",
			        Pedidos >= 2 && Dias = 1, "Múltiplos no mesmo dia",
			        "Verificar classificação"
			    )
			
			```
		displayFolder: 03 - Clientes e Recompra
		lineageTag: e7ac3e40-e849-4aa1-a4c3-b6297b92f9c3

