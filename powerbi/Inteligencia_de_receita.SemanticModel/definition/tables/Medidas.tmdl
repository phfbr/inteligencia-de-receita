	measure 'Valor dos Produtos Entregues Elegíveis' = ```
			
			VAR PedidosElegiveis =
			    CALCULATETABLE (
			        VALUES ( fato_pedidos[order_id] ),
			        KEEPFILTERS (
			            fato_pedidos[order_status] = "delivered"
			        ),
			        KEEPFILTERS (
			            dim_clientes[membro_tipo] = "regular"
			        )
			    )
			RETURN
			    CALCULATE (
			        SUM ( fato_itens_pedido[price] ),
			        KEEPFILTERS (
			            TREATAS (
			                PedidosElegiveis,
			                fato_itens_pedido[order_id]
			            )
			        )
			    )
			
			```
