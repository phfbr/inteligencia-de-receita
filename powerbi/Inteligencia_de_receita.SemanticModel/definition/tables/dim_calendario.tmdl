	column AnoMesOrdem = ```
			
			IF(
			    ISBLANK(dim_calendario[dia]),
			    BLANK(),
			    YEAR(dim_calendario[dia]) * 100
			        + MONTH(dim_calendario[dia])
			)
			
			```
