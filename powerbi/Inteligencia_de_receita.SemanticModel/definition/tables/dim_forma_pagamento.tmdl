	column forma_pagamento_exibicao =
			
			SWITCH(
			    TRUE(),
			    dim_forma_pagamento[membro_tipo] = "nao_informado",
			        "Não Informado",
			    dim_forma_pagamento[membro_tipo] = "referencia_nao_encontrada",
			        "Referência Não Encontrada",
			    dim_forma_pagamento[payment_type] = "credit_card",
			        "Cartão de Crédito",
			    dim_forma_pagamento[payment_type] = "debit_card",
			        "Cartão de Débito",
			    dim_forma_pagamento[payment_type] = "boleto",
			        "Boleto",
			    dim_forma_pagamento[payment_type] = "voucher",
			        "Voucher",
			    dim_forma_pagamento[payment_type] = "not_defined",
			        "Não Definido",
			    dim_forma_pagamento[payment_type]
			)
		lineageTag: 97ead7d5-2ddb-430b-b94a-40afbcb72ad1
		summarizeBy: none

